# In case a single repo is ever initialized at this top level covering both
# frontend/ and backend/ — each folder also has its own .gitignore already.

# secrets — real API keys/DB password, never commit
**/.env
**/.env.*
!**/.env.example
!**/.env.local.example

# dependencies / build output
**/node_modules/
**/.next/
**/venv/
**/.venv/
**/__pycache__/

# OS
.DS_Store

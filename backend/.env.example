# Local Postgres (pgAdmin is just the GUI you inspect this with — no code depends on it)
DATABASE_URL=postgresql+asyncpg://postgres:<your-postgres-password>@localhost:5432/leadpilot

# Shared with frontend/.env.local.example's SESSION_COOKIE_SECRET — same value in both
# so a future direct cookie-verification in the frontend's middleware.ts can work.
SESSION_COOKIE_SECRET=dev-only-secret-change-me

# Any string works — it's hashed into a valid Fernet key, no separate keygen step.
INTEGRATION_ENCRYPTION_KEY=changeme-any-string-at-all

# Groq (free tier) — https://console.groq.com/keys
GROQ_API_KEY=

# Optional — leave blank to use the console/log fallback providers (see app/services/)
RESEND_API_KEY=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
CALENDLY_CLIENT_ID=
CALENDLY_CLIENT_SECRET=

# Phase 2 — leave false unless Redis is actually installed and running locally
USE_CELERY=false
REDIS_URL=redis://localhost:6379/0

ENVIRONMENT=development
